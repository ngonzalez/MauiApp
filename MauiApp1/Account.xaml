<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:strings="clr-namespace:MauiApp1.Resources.Strings"
             x:Class="MauiApp1.AccountPage">

    <ContentPage.Resources>
        <!-- The buttons opening My Account's forms, like the others here -->
        <Style x:Key="AccountFormButton" TargetType="Button">
            <Setter Property="FontSize" Value="14" />
            <Setter Property="BackgroundColor" Value="Black" />
            <Setter Property="TextColor" Value="FloralWhite" />
            <Setter Property="BorderColor" Value="Black" />
            <Setter Property="BorderWidth" Value="1" />
            <Setter Property="VerticalOptions" Value="Center" />
            <Setter Property="HorizontalOptions" Value="Center" />
            <Setter Property="VisualStateManager.VisualStateGroups">
                <VisualStateGroupList>
                    <VisualStateGroup x:Name="CommonStates">
                        <VisualState x:Name="Normal">
                            <VisualState.Setters>
                                <Setter Property="Scale" Value="1" />
                            </VisualState.Setters>
                        </VisualState>
                        <VisualState x:Name="Pressed">
                            <VisualState.Setters>
                                <Setter Property="Scale" Value="0.9" />
                            </VisualState.Setters>
                        </VisualState>
                        <VisualState x:Name="PointerOver">
                            <VisualState.Setters>
                                <Setter Property="BorderColor" Value="#555" />
                            </VisualState.Setters>
                        </VisualState>
                    </VisualStateGroup>
                </VisualStateGroupList>
            </Setter>
        </Style>
    </ContentPage.Resources>

    <!-- My Account on the left; on the right, the form one of its buttons
         opened (AccountForms, added by the code) -->
    <Grid ColumnDefinitions="380,*">
    <ScrollView Grid.Column="0">
        <VerticalStackLayout
            Padding="30,0"
            Spacing="25">

            <Image
                Source="dotnet_bot.png"
                HeightRequest="185"
                Aspect="AspectFit"
                SemanticProperties.Description="{strings:Translate DotNetBotDescription}" />

            <Label
                Text="{strings:Translate MyAccount}"
                x:Name="myAccountLabel"
                VerticalOptions="Center"
                HorizontalOptions="Center" />

            <!-- The account's plan and what it uses of it (GET /account) -->
            <VerticalStackLayout
                x:Name="planPanel"
                IsVisible="False"
                WidthRequest="260"
                HorizontalOptions="Center"
                Spacing="6">
                <Label
                    Text="{strings:Translate AccountUsage}"
                    FontAttributes="Bold"
                    FontSize="14" />
                <Label
                    x:Name="planNameLabel"
                    FontSize="12"
                    TextColor="Grey" />
                <Label
                    x:Name="planStorageLabel"
                    FontSize="12" />
                <ProgressBar
                    x:Name="planStorageBar" />
                <Label
                    x:Name="planUsersLabel"
                    FontSize="12" />
                <ProgressBar
                    x:Name="planUsersBar" />
            </VerticalStackLayout>

            <Button
                Text="{strings:Translate UploadFiles}"
                FontSize="14"
                x:Name="uploadsLink"
                BackgroundColor="Black"
                TextColor="FloralWhite"
                BorderColor="Black"
                BorderWidth="1"
                VerticalOptions="Center"
                HorizontalOptions="Center">
                <Button.ImageSource>
                    <FontImageSource
                            FontFamily="FontAwesome7FreeSolid"
                            Glyph="{StaticResource IconUpload}"
                            Size="14"
                            Color="SeaShell" />
                </Button.ImageSource>
                <VisualStateManager.VisualStateGroups>
                    <VisualStateGroupList>
                        <VisualStateGroup x:Name="CommonStates">
                            <VisualState x:Name="Normal">
                                <VisualState.Setters>
                                    <Setter Property="Scale" Value="1" />
                                </VisualState.Setters>
                            </VisualState>
                            <VisualState x:Name="Pressed">
                                <VisualState.Setters>
                                    <Setter Property="Scale" Value="0.9" />
                                </VisualState.Setters>
                            </VisualState>
                            <VisualState x:Name="PointerOver">
                                <VisualState.Setters>
                                    <Setter Property="BorderColor" Value="#555" />
                                </VisualState.Setters>
                            </VisualState>
                        </VisualStateGroup>
                    </VisualStateGroupList>
                </VisualStateManager.VisualStateGroups>
            </Button>

            <Button
                Text="{strings:Translate ListFolders}"
                FontSize="14"
                x:Name="listFoldersList"
                BackgroundColor="Black"
                TextColor="FloralWhite"
                BorderColor="Black"
                BorderWidth="1"
                VerticalOptions="Center"
                HorizontalOptions="Center">
                <Button.ImageSource>
                    <FontImageSource
                            FontFamily="FontAwesome7FreeSolid"
                            Glyph="{StaticResource IconFolderTree}"
                            Size="14"
                            Color="SeaShell" />
                </Button.ImageSource>
                <VisualStateManager.VisualStateGroups>
                    <VisualStateGroupList>
                        <VisualStateGroup x:Name="CommonStates">
                            <VisualState x:Name="Normal">
                                <VisualState.Setters>
                                    <Setter Property="Scale" Value="1" />
                                </VisualState.Setters>
                            </VisualState>
                            <VisualState x:Name="Pressed">
                                <VisualState.Setters>
                                    <Setter Property="Scale" Value="0.9" />
                                </VisualState.Setters>
                            </VisualState>
                            <VisualState x:Name="PointerOver">
                                <VisualState.Setters>
                                    <Setter Property="BorderColor" Value="#555" />
                                </VisualState.Setters>
                            </VisualState>
                        </VisualStateGroup>
                    </VisualStateGroupList>
                </VisualStateManager.VisualStateGroups>
            </Button>
            <!-- My Account's forms: each opens on the right (AccountForms) -->
            <Button
                Text="{strings:Translate EditAccount}"
                x:Name="editAccountLink"
                Style="{StaticResource AccountFormButton}">
                <Button.ImageSource>
                    <FontImageSource
                            FontFamily="FontAwesome7FreeSolid"
                            Glyph="{StaticResource IconUserGear}"
                            Size="14"
                            Color="SeaShell" />
                </Button.ImageSource>
            </Button>

            <Button
                Text="{strings:Translate ChangePassword}"
                x:Name="changePasswordLink"
                Style="{StaticResource AccountFormButton}">
                <Button.ImageSource>
                    <FontImageSource
                            FontFamily="FontAwesome7FreeSolid"
                            Glyph="{StaticResource IconKey}"
                            Size="14"
                            Color="SeaShell" />
                </Button.ImageSource>
            </Button>

            <Button
                Text="{strings:Translate InviteUsers}"
                x:Name="inviteUsersLink"
                Style="{StaticResource AccountFormButton}">
                <Button.ImageSource>
                    <FontImageSource
                            FontFamily="FontAwesome7FreeSolid"
                            Glyph="{StaticResource IconUserPlus}"
                            Size="14"
                            Color="SeaShell" />
                </Button.ImageSource>
            </Button>

            <Button
                Text="{strings:Translate ChangeEmailAddress}"
                x:Name="changeEmailLink"
                Style="{StaticResource AccountFormButton}">
                <Button.ImageSource>
                    <FontImageSource
                            FontFamily="FontAwesome7FreeSolid"
                            Glyph="{StaticResource IconEnvelope}"
                            Size="14"
                            Color="SeaShell" />
                </Button.ImageSource>
            </Button>

            <Button
                Text="{strings:Translate SignOut}"
                FontSize="14"
                x:Name="signOutLink"
                BackgroundColor="Black"
                TextColor="Gray"
                VerticalOptions="Center"
                HorizontalOptions="Center" />

        </VerticalStackLayout>
    </ScrollView>

    <ScrollView Grid.Column="1">
        <ContentView
            x:Name="formPanel"
            MaximumWidthRequest="560"
            HorizontalOptions="Center"
            VerticalOptions="Start" />
    </ScrollView>
    </Grid>
</ContentPage>