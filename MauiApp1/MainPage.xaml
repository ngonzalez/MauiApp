<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="MauiApp1.MainPage">

    <ScrollView>
        <VerticalStackLayout
            Padding="30,0"
            Spacing="25">

            <Button
                Text="Back to my account"
                x:Name="myAccountLink"
                BackgroundColor="Black"
                TextColor="FloralWhite"
                FontSize="20"
                VerticalOptions="Center"
                HorizontalOptions="Center">
                <Button.ImageSource>
                    <FontImageSource
                        FontFamily="FontAwesome7FreeSolid"
                        Glyph="{StaticResource IconCircleArrowLeft}"
                        Size="20"
                        Color="Grey" />
                </Button.ImageSource>
            </Button>

            <Image
                Source="dotnet_bot.png"
                HeightRequest="185"
                Aspect="AspectFit"
                SemanticProperties.Description="dot net bot in a hovercraft number nine" />

            <Label 
                Text=""
                Grid.Row="0"
                FontSize="15"
                FontAttributes="Bold"
                x:Name="FolderLabel"
                HorizontalOptions="Center" />

            <Label
                x:Name="labelFilesCount"
                FontSize="12"
                HorizontalOptions="Center" />

            <Button 
                Text="Pick Folder"
                FontAttributes="Bold"
                Grid.Row="1"
                SemanticProperties.Hint="Allows you to pick a folder on the filesystem"
                Clicked="OnPickFolderClicked"
                HorizontalOptions="Center" />

            <Grid Padding="10">
                <Button
                    Text="Send Files"
                    FontAttributes="Bold"
                    Grid.Row="1"
                    SemanticProperties.Hint="POST data to our servers"
                    Clicked="OnSendDataClicked"
                    HorizontalOptions="Center" />
            </Grid>

            <Grid Padding="10">
                <Label
                    x:Name="progressBarText"></Label>
            </Grid>

            <Grid Padding="10">
                <ProgressBar
                    x:Name="progressBar"/>
            </Grid>

            <Grid Padding="10">
                <CollectionView ItemsSource="{Binding Folders}">
                    <CollectionView.EmptyView>
                        <Label Text="No data found." HorizontalOptions="Center" VerticalOptions="Center" />
                    </CollectionView.EmptyView>
                    <CollectionView.ItemTemplate>
                        <DataTemplate>
                            <Grid Padding="10">
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                </Grid.RowDefinitions>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <Image>
                                    <Image.Source>
                                        <FontImageSource
                                            Grid.Row="0"
                                            Grid.Column="0"
                                            FontFamily="FontAwesome7FreeRegular"
                                            Glyph="{StaticResource IconFolder}"
                                            Color="DarkGrey"
                                            Size="20"/>
                                    </Image.Source>
                                </Image>
                                <Label Grid.Row="0"
                                       Grid.Column="1"
                                       Text="{Binding name}"
                                       FontAttributes="Bold"
                                       FontSize="20"
                                       Padding="10" />
                            </Grid>
                        </DataTemplate>
                    </CollectionView.ItemTemplate>
                </CollectionView>
            </Grid>

        </VerticalStackLayout>
    </ScrollView>

</ContentPage>
