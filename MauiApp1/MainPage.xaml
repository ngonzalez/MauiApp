<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="MauiApp1.MainPage">

    <ScrollView>
        <VerticalStackLayout
            Padding="30,0"
            Spacing="25">

            <Button
                Text="Back to my account"
                x:Name="myAccountLink"
                BackgroundColor="Black"
                TextColor="FloralWhite"
                FontSize="20"
                VerticalOptions="Center"
                HorizontalOptions="Center">
                <Button.ImageSource>
                    <FontImageSource
                        FontFamily="FontAwesome7FreeSolid"
                        Glyph="{StaticResource IconCircleArrowLeft}"
                        Size="20"
                        Color="FloralWhite" />
                </Button.ImageSource>
            </Button>

            <Image
                Source="dotnet_bot.png"
                HeightRequest="185"
                Aspect="AspectFit"
                SemanticProperties.Description="dot net bot in a hovercraft number nine" />

            <Label 
                Text=""
                Grid.Row="0"
                FontSize="15"
                FontAttributes="Bold"
                x:Name="FolderLabel"
                HorizontalOptions="Center" />

            <Label
                x:Name="labelFilesCount"
                FontSize="12"
                HorizontalOptions="Center" />

            <Button 
                Text="Pick Folder"
                FontAttributes="Bold"
                Grid.Row="1"
                SemanticProperties.Hint="Allows you to pick a folder on the filesystem"
                Clicked="OnPickFolderClicked"
                HorizontalOptions="Center" />

            <Grid>
                <Button
                    Text="Send Files"
                    FontAttributes="Bold"
                    Grid.Row="1"
                    SemanticProperties.Hint="POST data to our servers"
                    Clicked="OnSendDataClicked"
                    HorizontalOptions="Center" />
            </Grid>

            <Grid>
                <Label
                    x:Name="progressBarText"></Label>
            </Grid>

            <Grid>
                <ProgressBar
                    x:Name="progressBar"/>
            </Grid>

            <Grid>
                <Rectangle
                    BackgroundColor="Transparent"
                    HeightRequest="50">
                </Rectangle>
                <Label
                    x:Name="foldersCount"
                    FontSize="20"
                    BackgroundColor="Transparent"
                    TextColor="FloralWhite"
                    VerticalTextAlignment="Center"
                    HorizontalTextAlignment="Center"></Label>
            </Grid>

            <Grid MinimumHeightRequest="500" Padding="10">
                <ActivityIndicator x:Name="ActivityIndicator" />
                <ScrollView x:Name="scrollView"
                    Grid.Row="1"
                    VerticalOptions="Fill">
                    <CollectionView ItemsSource="{Binding Folders}"
                                SelectionMode="Single"
                                SelectionChanged="FolderSelectionChanged"
                                SelectedItems="{Binding SelectedImageFiles}">
                        <CollectionView.EmptyView>
                            <Label Text="No data found." HorizontalOptions="Center" VerticalOptions="Center" />
                        </CollectionView.EmptyView>
                        <CollectionView.ItemTemplate>
                            <DataTemplate>
                                <Grid Padding="10">
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="Auto" />
                                    </Grid.RowDefinitions>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <HorizontalStackLayout>
                                        <Button
                                            Grid.Row="0"
                                            Grid.Column="1"
                                            Text="{Binding name}"
                                            Clicked="displayFiles"
                                            TextColor="FloralWhite"
                                            BackgroundColor="Transparent"
                                            FontSize="20"
                                            Padding="10">
                                            <Button.ImageSource>
                                                <FontImageSource
                                                    FontFamily="FontAwesome7FreeSolid"
                                                    Glyph="{StaticResource IconFolder}"
                                                    Size="30"
                                                    Color="LightGrey" />
                                            </Button.ImageSource>
                                        </Button>
                                        <Button
                                            Grid.Row="0"
                                            Grid.Column="2"
                                            Clicked="displayFiles"
                                            BackgroundColor="Transparent"
                                            MinimumWidthRequest="1000">
                                        </Button>
                                    </HorizontalStackLayout>
                                </Grid>
                            </DataTemplate>
                        </CollectionView.ItemTemplate>
                    </CollectionView>
                </ScrollView>
            </Grid>

            <Grid>
                <Button
                    Text="Refresh"
                    x:Name="refreshFilesButton"
                    BackgroundColor="Black"
                    TextColor="FloralWhite"
                    FontSize="20"
                    VerticalOptions="Center"
                    HorizontalOptions="Center">
                    <Button.ImageSource>
                        <FontImageSource
                            FontFamily="FontAwesome7FreeSolid"
                            Glyph="{StaticResource IconSun}"
                            Size="15"
                            Color="FloralWhite" />
                    </Button.ImageSource>
                </Button>
            </Grid>

        </VerticalStackLayout>
    </ScrollView>
</ContentPage>
