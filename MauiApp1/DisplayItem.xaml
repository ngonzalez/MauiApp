<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="MauiApp1.DisplayItemPage">

    <ScrollView>
        <VerticalStackLayout
        Padding="30,0"
        Spacing="25">

            <Label
                x:Name="folderName"
                FontSize="20"
                HorizontalOptions="Center"
                Padding="10" />

            <Label
                x:Name="imageFilesCount"
                FontSize="20"
                HorizontalOptions="Center"
                Padding="10" />

            <Label
                x:Name="selectedImagesList"
                FontSize="20"
                HorizontalOptions="Center"
                Padding="10" />

            <Grid MinimumHeightRequest="300">
                <ScrollView x:Name="scrollView"
                    Grid.Row="1"
                    VerticalOptions="Fill"
                    Scrolled="OnScrollViewScrolled">

                    <CollectionView ItemsSource="{Binding ImageFiles}"
                                    SelectionMode="Single"
                                    SelectionChanged="ImageFilesSelectionChanged"
                                    SelectedItems="{Binding SelectedImageFiles}">

                        <CollectionView.EmptyView>
                            <Label Text="No data found."
                                   HorizontalOptions="Center"
                                   VerticalOptions="Center" />
                        </CollectionView.EmptyView>
                        <CollectionView.ItemTemplate>
                            <DataTemplate>
                                <Grid Padding="10">
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition Height="Auto" />
                                    </Grid.RowDefinitions>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <HorizontalStackLayout>
                                        <Button
                                            Grid.Row="0"
                                            Grid.Column="1"
                                            Text="{Binding fileName}"
                                            Clicked="displayImage"
                                            TextColor="FloralWhite"
                                            BackgroundColor="Transparent"
                                            FontSize="20"
                                            Padding="10">
                                            <Button.ImageSource>
                                                <FontImageSource
                                                    FontFamily="FontAwesome7FreeSolid"
                                                    Glyph="{StaticResource IconImage}"
                                                    Size="20"
                                                    Color="LightGray" />
                                            </Button.ImageSource>
                                        </Button>
                                        <Button
                                            Grid.Row="0"
                                            Grid.Column="2"
                                            Clicked="displayImage"
                                            BackgroundColor="Transparent"
                                            MinimumWidthRequest="600">
                                        </Button>
                                    </HorizontalStackLayout>
                                </Grid>
                            </DataTemplate>
                        </CollectionView.ItemTemplate>
                    </CollectionView>
                </ScrollView>
            </Grid>
        </VerticalStackLayout>
    </ScrollView>
</ContentPage>