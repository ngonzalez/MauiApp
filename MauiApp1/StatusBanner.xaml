<?xml version="1.0" encoding="utf-8" ?>
<!-- A thin bar at the top of every page while an incident, a maintenance or
     a note is ongoing on status.appshare.site (StatusMonitor): its title and
     since when, Details opens the status page, the cross hides it -->
<ContentView xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:strings="clr-namespace:MauiApp1.Resources.Strings"
             x:Class="MauiApp1.StatusBanner">
    <Grid IsVisible="{Binding IsVisible}"
          BackgroundColor="{Binding BackgroundColor}"
          Padding="14,7"
          ColumnSpacing="10"
          ColumnDefinitions="Auto,Auto,Auto,Auto,*,Auto,Auto">
        <Label Grid.Column="0" Text="{Binding Icon}" FontFamily="FontAwesome7FreeSolid" FontSize="13"
               TextColor="{Binding TextColor}" VerticalOptions="Center" />
        <Label Grid.Column="1" Text="{Binding Title}" FontAttributes="Bold" FontSize="13"
               TextColor="{Binding TextColor}" VerticalOptions="Center" LineBreakMode="TailTruncation" />
        <Label Grid.Column="2" Text="{Binding Since}" FontSize="13" Opacity="0.85"
               TextColor="{Binding TextColor}" VerticalOptions="Center" />
        <Label Grid.Column="3" Text="{Binding More}" IsVisible="{Binding HasMore}" FontSize="13" Opacity="0.85"
               TextColor="{Binding TextColor}" VerticalOptions="Center" />
        <Label Grid.Column="5" Text="{strings:Translate StatusDetails}" FontSize="13" TextDecorations="Underline"
               TextColor="{Binding TextColor}" VerticalOptions="Center">
            <Label.GestureRecognizers>
                <TapGestureRecognizer Tapped="DetailsTapped" />
            </Label.GestureRecognizers>
        </Label>
        <Label Grid.Column="6" Text="&#xd7;" FontFamily="FontAwesome7FreeSolid" FontSize="13"
               TextColor="{Binding TextColor}" VerticalOptions="Center"
               ToolTipProperties.Text="{strings:Translate StatusHide}">
            <Label.GestureRecognizers>
                <TapGestureRecognizer Tapped="HideTapped" />
            </Label.GestureRecognizers>
        </Label>
    </Grid>
</ContentView>
