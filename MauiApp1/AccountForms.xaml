<?xml version="1.0" encoding="utf-8" ?>
<ContentView xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:strings="clr-namespace:MauiApp1.Resources.Strings"
             xmlns:local="clr-namespace:MauiApp1"
             x:Class="MauiApp1.AccountForms"
             IsVisible="False">

    <!-- The right pane of My Account (AccountPage): one form at a time,
         opened by its buttons (Open), closed by Close -->
    <VerticalStackLayout
        Padding="30,20"
        Spacing="25">

        <!-- Edit Account: the picture and the user's details -->
        <VerticalStackLayout
            x:Name="editAccountSection"
            IsVisible="False"
            Spacing="25">
            <Label
                FontSize="20"
                FontAttributes="Bold" Text="{strings:Translate EditAccount}" />

            <!-- The account picture (PUT /user/avatar): a file or a preset,
                 sent as soon as it is chosen -->
            <local:UserAvatar
                Size="96"
                HorizontalOptions="Center" />

            <HorizontalStackLayout
                Spacing="10"
                HorizontalOptions="Center">
                <Button
                    Text="{strings:Translate ChoosePicture}"
                    SemanticProperties.Hint="{strings:Translate ChoosePicture}"
                    Clicked="OnChoosePictureClicked"
                    BackgroundColor="Black"
                    TextColor="FloralWhite" />
                <Button
                    Text="{strings:Translate RemovePicture}"
                    SemanticProperties.Hint="{strings:Translate RemovePicture}"
                    Clicked="OnRemovePictureClicked"
                    IsVisible="{Binding HasPicture, Source={x:Static local:CurrentUserAvatar.Shared}}"
                    BackgroundColor="Black"
                    TextColor="FloralWhite" />
            </HorizontalStackLayout>

            <!-- The presets (GET /avatars/presets), hidden when they can't be read -->
            <VerticalStackLayout
                x:Name="avatarPresetsPanel"
                IsVisible="False"
                Spacing="8">
                <Label
                    TextColor="#CCC"
                    FontSize="15"
                    HorizontalOptions="Center"
                    Text="{strings:Translate ChooseAvatarPreset}" />
                <FlexLayout
                    x:Name="avatarPresets"
                    Wrap="Wrap"
                    JustifyContent="Center"
                    MaximumWidthRequest="480">
                    <BindableLayout.ItemTemplate>
                        <DataTemplate x:DataType="local:AvatarPreset">
                            <Border
                                WidthRequest="48"
                                HeightRequest="48"
                                Margin="4"
                                Padding="0"
                                StrokeThickness="0"
                                StrokeShape="RoundRectangle 24"
                                ToolTipProperties.Text="{Binding name}">
                                <Image
                                    Source="{Binding url}"
                                    Aspect="AspectFill" />
                                <Border.GestureRecognizers>
                                    <TapGestureRecognizer Tapped="OnAvatarPresetTapped" />
                                </Border.GestureRecognizers>
                            </Border>
                        </DataTemplate>
                    </BindableLayout.ItemTemplate>
                </FlexLayout>
            </VerticalStackLayout>

            <Label
                x:Name="avatarErrors"
                HorizontalTextAlignment="Center" />

            <Label
                TextColor="#CCC"
                FontSize="15"
                Padding="5" Text="{strings:Translate AccountName}" />

            <Entry
                Placeholder="{strings:Translate AccountName}"
                x:Name="accountName"
                TextChanged="OnAccountNameCompleted" />

            <Label
                TextColor="#CCC"
                FontSize="15"
                Padding="5"
                Text="{strings:Translate AccountSubdomain}" />

            <!-- The address of the account's site: <subdomain>.appshare.site.
                 Read-only, like in DemoApp: it is chosen at registration -->
            <HorizontalStackLayout Spacing="4">
                <Entry
                    Placeholder="{strings:Translate AccountSubdomain}"
                    x:Name="accountSubdomain"
                    WidthRequest="320"
                    TextColor="Grey"
                    Opacity="0.9"
                    IsReadOnly="True" />
                <Label
                    Text=".appshare.site"
                    VerticalOptions="Center" />
            </HorizontalStackLayout>

            <Label
                TextColor="#CCC"
                FontSize="15"
                Padding="5" Text="{strings:Translate AccountAddress}" />

            <Entry
                Placeholder="{strings:Translate AccountAddress}"
                x:Name="accountAddress"
                TextChanged="OnAccountAddressCompleted" />

            <Label
                TextColor="#CCC"
                FontSize="15" Text="{strings:Translate FirstName}" />

            <Entry
                Placeholder="{strings:Translate FirstName}"
                x:Name="editAccountFirstName"
                TextChanged="OnFirstNameCompleted" />

            <Label
                TextColor="#CCC"
                FontSize="15" Text="{strings:Translate LastName}" />

            <Entry
                Placeholder="{strings:Translate LastName}"
                x:Name="editAccountLastName"
                TextChanged="OnLastNameCompleted" />

            <Label
                TextColor="#CCC"
                FontSize="15" Text="{strings:Translate EmailAddress}" />

            <Entry
                Placeholder="{strings:Translate EmailAddress}"
                x:Name="editAccountEmailAddress"
                TextChanged="OnEmailAddressCompleted"/>

            <Label
                TextColor="#CCC"
                FontSize="15" Text="{strings:Translate CreatedAt}" />

            <Entry
                Placeholder="{strings:Translate CreatedAt}"
                x:Name="editAccountCreatedAt"
                TextColor="Grey"
                Opacity="0.9"
                IsReadOnly="True" />

            <Label
                TextColor="#CCC"
                FontSize="15" Text="{strings:Translate UpdatedAt}" />

            <Entry
                Placeholder="{strings:Translate UpdatedAt}"
                x:Name="editAccountUpdatedAt"
                TextColor="Grey"
                Opacity="0.9"
                IsReadOnly="True" />

            <Label
                TextColor="#CCC"
                FontSize="15" Text="{strings:Translate NotifyOnSignIn}" />

            <CheckBox
                x:Name="editAccountDeliverNotificationsOnSignIn" />

            <Label
                TextColor="#CCC"
                FontSize="15" Text="{strings:Translate NotifyOnAccountUpdate}" />

            <CheckBox
                x:Name="editAccountDeliverNotificationsOnAccountUpdate" />

            <Button
                Text="{strings:Translate UpdateAccount}"
                FontAttributes="Bold"
                SemanticProperties.Hint="{strings:Translate UpdateAccount}"
                Clicked="OnUpdateAccountClicked"
                BackgroundColor="Black"
                TextColor="FloralWhite"
                HorizontalOptions="Center">
                <VisualStateManager.VisualStateGroups>
                    <VisualStateGroupList>
                        <VisualStateGroup x:Name="CommonStates">
                            <VisualState x:Name="Normal">
                                <VisualState.Setters>
                                    <Setter Property="Scale" Value="1" />
                                </VisualState.Setters>
                            </VisualState>
                            <VisualState x:Name="Pressed">
                                <VisualState.Setters>
                                    <Setter Property="Scale" Value="0.9" />
                                </VisualState.Setters>
                            </VisualState>
                            <VisualState x:Name="PointerOver">
                                <VisualState.Setters>
                                    <Setter Property="BorderColor" Value="Black" />
                                </VisualState.Setters>
                            </VisualState>
                        </VisualStateGroup>
                    </VisualStateGroupList>
                </VisualStateManager.VisualStateGroups>
            </Button>

            <Label
                x:Name="accountErrors"
                HorizontalTextAlignment="Center" />
        </VerticalStackLayout>

        <!-- Change Password -->
        <VerticalStackLayout
            x:Name="changePasswordSection"
            IsVisible="False"
            Spacing="25">
            <Label
                FontSize="20"
                FontAttributes="Bold" Text="{strings:Translate ChangePassword}" />

            <Label
                TextColor="#CCC"
                FontSize="15" Text="{strings:Translate NewPassword}" />

            <Entry
                Placeholder="{strings:Translate Password}"
                IsPassword="True"
                x:Name="changePasswordPassword"
                TextChanged="OnPasswordCompleted" />

            <Label
                TextColor="#CCC"
                FontSize="15" Text="{strings:Translate NewPasswordConfirmation}" />

            <Entry
                Placeholder="{strings:Translate PasswordConfirmation}"
                IsPassword="True"
                x:Name="changePasswordPasswordConfirmation"
                TextChanged="OnPasswordConfirmationCompleted" />

            <Button
                Text="{strings:Translate UpdatePassword}"
                FontAttributes="Bold"
                SemanticProperties.Hint="{strings:Translate UpdatePassword}"
                Clicked="OnUpdatePasswordClicked"
                BackgroundColor="Black"
                TextColor="FloralWhite"
                HorizontalOptions="Center">
                <VisualStateManager.VisualStateGroups>
                    <VisualStateGroupList>
                        <VisualStateGroup x:Name="CommonStates">
                            <VisualState x:Name="Normal">
                                <VisualState.Setters>
                                    <Setter Property="Scale" Value="1" />
                                </VisualState.Setters>
                            </VisualState>
                            <VisualState x:Name="Pressed">
                                <VisualState.Setters>
                                    <Setter Property="Scale" Value="0.9" />
                                </VisualState.Setters>
                            </VisualState>
                            <VisualState x:Name="PointerOver">
                                <VisualState.Setters>
                                    <Setter Property="BorderColor" Value="Black" />
                                </VisualState.Setters>
                            </VisualState>
                        </VisualStateGroup>
                    </VisualStateGroupList>
                </VisualStateManager.VisualStateGroups>
            </Button>

            <Label
                x:Name="passwordErrors"
                HorizontalTextAlignment="Center" />
        </VerticalStackLayout>

        <!-- Change Email Address -->
        <VerticalStackLayout
            x:Name="changeEmailSection"
            IsVisible="False"
            Spacing="25">
            <Label
                FontSize="20"
                FontAttributes="Bold" Text="{strings:Translate ChangeEmailAddress}" />

            <Label
                TextColor="#CCC"
                FontSize="15" Text="{strings:Translate CurrentEmailAddress}" />

            <Entry
                Placeholder="{strings:Translate CurrentEmailAddress}"
                x:Name="changeEmailCurrentEmailAddress"
                TextColor="Grey"
                Opacity="0.9"
                IsReadOnly="True" />

            <Label
                TextColor="#CCC"
                FontSize="15" Text="{strings:Translate NewEmailAddress}" />

            <Entry
                Placeholder="{strings:Translate NewEmailAddress}"
                x:Name="changeEmailNewEmailAddress"
                TextChanged="OnNewEmailAddressCompleted" />

            <Button
                Text="{strings:Translate UpdateEmailAddress}"
                FontAttributes="Bold"
                SemanticProperties.Hint="{strings:Translate UpdateEmail}"
                Clicked="OnUpdateEmailClicked"
                BackgroundColor="Black"
                TextColor="FloralWhite"
                HorizontalOptions="Center">
                <VisualStateManager.VisualStateGroups>
                    <VisualStateGroupList>
                        <VisualStateGroup x:Name="CommonStates">
                            <VisualState x:Name="Normal">
                                <VisualState.Setters>
                                    <Setter Property="Scale" Value="1" />
                                </VisualState.Setters>
                            </VisualState>
                            <VisualState x:Name="Pressed">
                                <VisualState.Setters>
                                    <Setter Property="Scale" Value="0.9" />
                                </VisualState.Setters>
                            </VisualState>
                            <VisualState x:Name="PointerOver">
                                <VisualState.Setters>
                                    <Setter Property="BorderColor" Value="Black" />
                                </VisualState.Setters>
                            </VisualState>
                        </VisualStateGroup>
                    </VisualStateGroupList>
                </VisualStateManager.VisualStateGroups>
            </Button>

            <Label
                x:Name="emailAddressErrors"
                HorizontalTextAlignment="Center" />
        </VerticalStackLayout>

        <!-- Invite someone by email to join this account (POST /invitations) -->
        <VerticalStackLayout
            x:Name="inviteUsersSection"
            IsVisible="False"
            Spacing="25">
            <Label
                FontSize="20"
                FontAttributes="Bold" Text="{strings:Translate InviteUsers}" />

            <Label
                FontSize="15" Text="{strings:Translate InviteUsersDescription}" />

            <Label
                TextColor="#CCC"
                FontSize="15" Text="{strings:Translate EmailAddress}" />

            <Entry
                Placeholder="{strings:Translate EmailAddress}"
                x:Name="invitationEmailAddress"
                Keyboard="Email"
                Completed="OnSendInvitationClicked" />

            <Button
                Text="{strings:Translate SendInvitation}"
                FontAttributes="Bold"
                SemanticProperties.Hint="{strings:Translate SendInvitation}"
                Clicked="OnSendInvitationClicked"
                BackgroundColor="Black"
                TextColor="FloralWhite"
                HorizontalOptions="Center">
                <VisualStateManager.VisualStateGroups>
                    <VisualStateGroupList>
                        <VisualStateGroup x:Name="CommonStates">
                            <VisualState x:Name="Normal">
                                <VisualState.Setters>
                                    <Setter Property="Scale" Value="1" />
                                </VisualState.Setters>
                            </VisualState>
                            <VisualState x:Name="Pressed">
                                <VisualState.Setters>
                                    <Setter Property="Scale" Value="0.9" />
                                </VisualState.Setters>
                            </VisualState>
                            <VisualState x:Name="PointerOver">
                                <VisualState.Setters>
                                    <Setter Property="BorderColor" Value="Black" />
                                </VisualState.Setters>
                            </VisualState>
                        </VisualStateGroup>
                    </VisualStateGroupList>
                </VisualStateManager.VisualStateGroups>
            </Button>

            <Label
                x:Name="invitationErrors"
                HorizontalTextAlignment="Center" />
        </VerticalStackLayout>

        <Button
            Text="{strings:Translate Close}"
            SemanticProperties.Hint="{strings:Translate Close}"
            Clicked="OnCloseClicked"
            BackgroundColor="Black"
            TextColor="FloralWhite"
            HorizontalOptions="Center">
            <Button.ImageSource>
                <FontImageSource
                    FontFamily="FontAwesome7FreeSolid"
                    Glyph="{StaticResource IconXmark}"
                    Size="14"
                    Color="FloralWhite" />
            </Button.ImageSource>
        </Button>

    </VerticalStackLayout>
</ContentView>
