<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:strings="clr-namespace:MauiApp1.Resources.Strings"
             x:Class="MauiApp1.SignInPage"
             Title="">

    <ScrollView>
        <VerticalStackLayout
            Padding="30,0"
            Spacing="25">

            <Image
                Source="dotnet_bot.png"
                HeightRequest="185"
                Aspect="AspectFit"
                SemanticProperties.Description="{strings:Translate DotNetBotDescription}" />

            <Label
                Text="{strings:Translate Welcome}"
                VerticalOptions="Center"
                HorizontalOptions="Center" />

            <!-- Enter: to the password, then sign in -->
            <Entry
                x:Name="emailAddressEntry"
                Placeholder="{strings:Translate EmailAddress}"
                ReturnType="Next"
                TextChanged="OnEmailAddressCompleted"
                Completed="OnEmailAddressEnter" />

            <Entry
                x:Name="passwordEntry"
                Placeholder="{strings:Translate Password}"
                IsPassword="True"
                ReturnType="Go"
                TextChanged="OnPasswordCompleted"
                Completed="OnSignInClicked" />

            <Button
                Text="{strings:Translate SignIn}"
                FontSize="14"
                FontAttributes="Bold"
                SemanticProperties.Hint="{strings:Translate SignIn}"
                Clicked="OnSignInClicked"
                BackgroundColor="Black"
                TextColor="FloralWhite"
                BorderColor="Black"
                BorderWidth="1"
                VerticalOptions="Center"
                HorizontalOptions="Center">
                <Button.ImageSource>
                    <FontImageSource
                            FontFamily="FontAwesome7FreeSolid"
                            Glyph="{StaticResource IconUserGroup}"
                            Size="14"
                            Color="SeaShell" />
                </Button.ImageSource>
                <VisualStateManager.VisualStateGroups>
                    <VisualStateGroupList>
                        <VisualStateGroup x:Name="CommonStates">
                            <VisualState x:Name="Normal">
                                <VisualState.Setters>
                                    <Setter Property="Scale" Value="1" />
                                </VisualState.Setters>
                            </VisualState>
                            <VisualState x:Name="Pressed">
                                <VisualState.Setters>
                                    <Setter Property="Scale" Value="0.9" />
                                </VisualState.Setters>
                            </VisualState>
                            <VisualState x:Name="PointerOver">
                                <VisualState.Setters>
                                    <Setter Property="BorderColor" Value="#555" />
                                </VisualState.Setters>
                            </VisualState>
                        </VisualStateGroup>
                    </VisualStateGroupList>
                </VisualStateManager.VisualStateGroups>
            </Button>

            <Label
                x:Name="signInErrors"
                HorizontalTextAlignment="Center" />

            <Button
                Text="{strings:Translate RegisterNewAccount}"
                FontSize="14"
                SemanticProperties.Hint="{strings:Translate Register}"
                Clicked="OnRegisterClicked"
                BackgroundColor="Transparent"
                BorderColor="#222"
                BorderWidth="1"
                TextColor="FloralWhite"
                HorizontalOptions="Center">
                <Button.ImageSource>
                    <FontImageSource
                        FontFamily="FontAwesome7FreeSolid"
                        Glyph="{StaticResource IconClipboardList}"
                        Size="14"
                        Color="SeaShell" />
                </Button.ImageSource>
                <VisualStateManager.VisualStateGroups>
                    <VisualStateGroupList>
                        <VisualStateGroup x:Name="CommonStates">
                            <VisualState x:Name="Normal">
                                <VisualState.Setters>
                                    <Setter Property="Scale" Value="1" />
                                </VisualState.Setters>
                            </VisualState>
                            <VisualState x:Name="Pressed">
                                <VisualState.Setters>
                                    <Setter Property="Scale" Value="1" />
                                </VisualState.Setters>
                            </VisualState>
                            <VisualState x:Name="PointerOver">
                                <VisualState.Setters>
                                    <Setter Property="BorderColor" Value="#555" />
                                </VisualState.Setters>
                            </VisualState>
                        </VisualStateGroup>
                    </VisualStateGroupList>
                </VisualStateManager.VisualStateGroups>
            </Button>

            <Button
                Text="{strings:Translate ResetYourPassword}"
                FontSize="14"
                SemanticProperties.Hint="{strings:Translate ResetPassword}"
                Clicked="OnResetPasswordClicked"
                BackgroundColor="Transparent"
                BorderColor="#222"
                BorderWidth="1"
                TextColor="FloralWhite"
                HorizontalOptions="Center">
                <Button.ImageSource>
                    <FontImageSource
                        FontFamily="FontAwesome7FreeSolid"
                        Glyph="{StaticResource IconEnvelopeOpen}"
                        Size="14"
                        Color="SeaShell" />
                </Button.ImageSource>
                <VisualStateManager.VisualStateGroups>
                    <VisualStateGroupList>
                        <VisualStateGroup x:Name="CommonStates">
                            <VisualState x:Name="Normal">
                                <VisualState.Setters>
                                    <Setter Property="Scale" Value="1" />
                                </VisualState.Setters>
                            </VisualState>
                            <VisualState x:Name="Pressed">
                                <VisualState.Setters>
                                    <Setter Property="Scale" Value="1" />
                                </VisualState.Setters>
                            </VisualState>
                            <VisualState x:Name="PointerOver">
                                <VisualState.Setters>
                                    <Setter Property="BorderColor" Value="#555" />
                                </VisualState.Setters>
                            </VisualState>
                        </VisualStateGroup>
                    </VisualStateGroupList>
                </VisualStateManager.VisualStateGroups>
            </Button>

            <Rectangle HeightRequest="300" />

        </VerticalStackLayout>
    </ScrollView>
</ContentPage>