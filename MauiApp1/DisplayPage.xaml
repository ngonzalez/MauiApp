                                Margin="10" />
                            <Button
                                x:Name="updateTextFilesButton"
                                Text="Update Text Files"
                                FontSize="14"
                                Clicked="updateTextFilesButtonClicked"
                                FontAttributes="Bold"
                                SemanticProperties.Hint="Update Text Files"
                                BackgroundColor="Black"
                                BorderColor="Black"
                                BorderWidth="1"
                                CornerRadius="5"
                                TextColor="Gray"
                                Padding="10"
                                Margin="10">
                                <Button.ImageSource>
                                    <FontImageSource
                                        x:Name="updateTextFilesButtonImage"
                                        FontFamily="FontAwesome7FreeSolid"
                                        Glyph="{StaticResource IconChevronRight}"
                                        Size="20"
                                        Color="Gray" />
                                </Button.ImageSource>
                                <VisualStateManager.VisualStateGroups>
                                    <VisualStateGroupList>
                                        <VisualStateGroup x:Name="CommonStates">
                                            <VisualState x:Name="Normal">
                                                <VisualState.Setters>
                                                    <Setter Property="Scale" Value="1" />
                                                </VisualState.Setters>
                                            </VisualState>
                                            <VisualState x:Name="Pressed">
                                                <VisualState.Setters>
                                                    <Setter Property="Scale" Value="0.9" />
                                                </VisualState.Setters>
                                            </VisualState>
                                            <VisualState x:Name="PointerOver">
                                                <VisualState.Setters>
                                                    <Setter Property="BorderColor" Value="#444" />
                                                </VisualState.Setters>
                                            </VisualState>
                                        </VisualStateGroup>
                                    </VisualStateGroupList>
                                </VisualStateManager.VisualStateGroups>
                            </Button>
                            <Button
                                Text="Refresh"
                                x:Name="refreshTextFilesButton"
                                BackgroundColor="Black"
                                TextColor="FloralWhite"
                                FontSize="14"
                                VerticalOptions="Center"
                                HorizontalOptions="Center">
                                <Button.ImageSource>
                                    <FontImageSource
                                        FontFamily="FontAwesome7FreeSolid"
                                        Glyph="{StaticResource IconRotate}"
                                        Size="15"
                                        Color="FloralWhite" />
                                </Button.ImageSource>
                                <VisualStateManager.VisualStateGroups>
                                    <VisualStateGroupList>
                                        <VisualStateGroup x:Name="CommonStates">
                                            <VisualState x:Name="Normal">
                                                <VisualState.Setters>
                                                    <Setter Property="Scale" Value="1" />
                                                </VisualState.Setters>
                                            </VisualState>
                                            <VisualState x:Name="Pressed">
                                                <VisualState.Setters>
                                                    <Setter Property="Scale" Value="0.9" />
                                                </VisualState.Setters>
                                            </VisualState>
                                            <VisualState x:Name="PointerOver">
                                                <VisualState.Setters>
                                                    <Setter Property="BorderColor" Value="#444" />
                                                </VisualState.Setters>
                                            </VisualState>
                                        </VisualStateGroup>
                                    </VisualStateGroupList>
                                </VisualStateManager.VisualStateGroups>
                            </Button>
                        </HorizontalStackLayout>
                    </VerticalStackLayout>
                </HorizontalStackLayout>
            </Grid>

            <Grid x:Name="GridTextFilesDetails">
                <HorizontalStackLayout>
                    <VerticalStackLayout MinimumWidthRequest="300" MaximumWidthRequest="400">
                        <Label
                            x:Name="folderName5"
                            FontSize="20"
                            HorizontalOptions="Center"
                            TextColor="FloralWhite"
                            BackgroundColor="Transparent"
                            Padding="10" />
                    </VerticalStackLayout>
                    <VerticalStackLayout MinimumWidthRequest="200" MaximumWidthRequest="200">
                    </VerticalStackLayout>
                    <VerticalStackLayout MinimumWidthRequest="300" MaximumWidthRequest="400">
                        <Label
                            x:Name="textFilesCount"
                            FontSize="20"
                            HorizontalOptions="Center"
                            TextColor="FloralWhite"
                            BackgroundColor="Transparent"
                            Padding="10" />
                    </VerticalStackLayout>
                </HorizontalStackLayout>
            </Grid>

        </VerticalStackLayout>
    </ScrollView>
</ContentPage>
