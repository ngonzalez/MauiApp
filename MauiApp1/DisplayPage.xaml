<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:toolkit="http://schemas.microsoft.com/dotnet/2022/maui/toolkit"
             x:Class="MauiApp1.DisplayPage"
             Loaded="DisplayPageLoaded"
             Unloaded="DisplayPageUnloaded">

    <ScrollView>
        <VerticalStackLayout
            Padding="30"
            Spacing="25">

            <Grid x:Name="GridMediaPlayer">
                <toolkit:MediaElement
                        x:Name="mediaElement"
                        ShouldAutoPlay="False"
                        ShouldShowPlaybackControls="True">
                </toolkit:MediaElement>
            </Grid>

            <Grid x:Name="GridMediaProcessing">
                <HorizontalStackLayout
                    HorizontalOptions="Center"
                    VerticalOptions="Center">
                    <Label
                        FontSize="20"
                        HorizontalOptions="Center"
                        TextColor="FloralWhite"
                        BackgroundColor="Transparent"
                        Padding="10">
                        Processing
                    </Label>
                    <Image
                        MinimumWidthRequest="30"
                        MaximumWidthRequest="30">
                        <Image.Source>
                            <FontImageSource
                                FontFamily="FontAwesome7FreeSolid"
                                Glyph="{StaticResource IconGears}"
                                Size="30"
                                Color="Grey" />
                        </Image.Source>
                    </Image>
                </HorizontalStackLayout>
            </Grid>

            <Grid x:Name="GridImageFiles">
                <HorizontalStackLayout Padding="50">
                    <VerticalStackLayout MinimumWidthRequest="450">
                        <ScrollView
                            x:Name="scrollViewSelectedImageFilesList"
                            Grid.Row="0"
                            VerticalOptions="Fill">

                            <CollectionView
                                ItemsSource="{Binding SelectedImageFiles}"
                                SelectionMode="Multiple"
                                SelectionChanged="SelectedImageFilesSelectionChanged">

                                <CollectionView.ItemTemplate>
                                    <DataTemplate>
                                        <Grid Padding="10">
                                            <Grid.RowDefinitions>
                                                <RowDefinition Height="Auto" />
                                                <RowDefinition Height="Auto" />
                                            </Grid.RowDefinitions>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="Auto" />
                                                <ColumnDefinition Width="Auto" />
                                            </Grid.ColumnDefinitions>
                                            <HorizontalStackLayout>
                                                <VerticalStackLayout>
                                                    <HorizontalStackLayout>
                                                        <Button
                                                            Text="{Binding fileName}"
                                                            ToolTipProperties.Text="{Binding fileName}"
                                                            x:Name="fileNameButton"
                                                            TextColor="FloralWhite"
                                                            BackgroundColor="Transparent"
                                                            FontSize="20"
                                                            Padding="10"
                                                            MinimumWidthRequest="500"
                                                            MaximumWidthRequest="500">
                                                            <Button.ImageSource>
                                                                <FontImageSource
                                                                    FontFamily="FontAwesome7FreeSolid"
                                                                    Glyph="{StaticResource IconFile}"
                                                                    Size="20"
                                                                    Color="FloralWhite" />
                                                            </Button.ImageSource>
                                                        </Button>
                                                    </HorizontalStackLayout>
                                                    <HorizontalStackLayout>
                                                        <Button
                                                            Text="⭠ Previous"
                                                            Clicked="previousLinkImageFileClicked"
                                                            TextColor="Gray"
                                                            BackgroundColor="Transparent"
                                                            FontSize="15"
                                                            Padding="10"
                                                            BorderColor="#444"
                                                            BorderWidth="1"
                                                            WidthRequest="100"
                                                            VerticalOptions="Center"
                                                            HorizontalOptions="Start">
                                                            <VisualStateManager.VisualStateGroups>
                                                                <VisualStateGroupList>
                                                                    <VisualStateGroup x:Name="CommonStates">
                                                                        <VisualState x:Name="Normal">
                                                                            <VisualState.Setters>
                                                                                <Setter Property="Scale" Value="1" />
                                                                            </VisualState.Setters>
                                                                        </VisualState>
                                                                        <VisualState x:Name="Pressed">
                                                                            <VisualState.Setters>
                                                                                <Setter Property="Scale" Value="0.9" />
                                                                                <Setter Property="BorderColor" Value="Black" />
                                                                            </VisualState.Setters>
                                                                        </VisualState>
                                                                        <VisualState x:Name="PointerOver">
                                                                            <VisualState.Setters>
                                                                                <Setter Property="BackgroundColor" Value="#222" />
                                                                            </VisualState.Setters>
                                                                        </VisualState>
                                                                    </VisualStateGroup>
                                                                </VisualStateGroupList>
                                                            </VisualStateManager.VisualStateGroups>
                                                        </Button>

                                                        <Rectangle WidthRequest="10" BackgroundColor="Transparent" />

                                                        <Button
                                                            Text="Open in new window"
                                                            Clicked="openNewWindowImageFile"
                                                            TextColor="Grey"
                                                            BackgroundColor="Transparent"
                                                            FontSize="15"
                                                            Padding="10"
                                                            BorderColor="#444"
                                                            BorderWidth="1"
                                                            WidthRequest="250"
                                                            VerticalOptions="Center"
                                                            HorizontalOptions="Center">
                                                            <Button.ImageSource>
                                                                <FontImageSource
                                                                    FontFamily="FontAwesome7FreeSolid"
                                                                    Glyph="{StaticResource IconClone}"
                                                                    Size="12"
                                                                    Color="Grey" />
                                                            </Button.ImageSource>
                                                            <VisualStateManager.VisualStateGroups>
                                                                <VisualStateGroupList>
                                                                    <VisualStateGroup x:Name="CommonStates">
                                                                        <VisualState x:Name="Normal">
                                                                            <VisualState.Setters>
                                                                                <Setter Property="Scale" Value="1" />
                                                                            </VisualState.Setters>
                                                                        </VisualState>
                                                                        <VisualState x:Name="Pressed">
                                                                            <VisualState.Setters>
                                                                                <Setter Property="Scale" Value="0.9" />
                                                                                <Setter Property="BorderColor" Value="Black" />
                                                                            </VisualState.Setters>
                                                                        </VisualState>
                                                                        <VisualState x:Name="PointerOver">
                                                                            <VisualState.Setters>
                                                                                <Setter Property="BackgroundColor" Value="#222" />
                                                                            </VisualState.Setters>
                                                                        </VisualState>
                                                                    </VisualStateGroup>
                                                                </VisualStateGroupList>
                                                            </VisualStateManager.VisualStateGroups>
                                                        </Button>

                                                        <Rectangle WidthRequest="10" BackgroundColor="Transparent" />

                                                        <Button
                                                            Text="Next ⭢"
                                                            Clicked="nextLinkImageFileClicked"
                                                            TextColor="Gray"
                                                            BackgroundColor="Transparent"
                                                            FontSize="15"
                                                            Padding="10"
                                                            BorderColor="#444"
                                                            BorderWidth="1"
                                                            WidthRequest="80"
                                                            VerticalOptions="Center"
                                                            HorizontalOptions="End">
                                                            <VisualStateManager.VisualStateGroups>
                                                                <VisualStateGroupList>
                                                                    <VisualStateGroup x:Name="CommonStates">
                                                                        <VisualState x:Name="Normal">
                                                                            <VisualState.Setters>
                                                                                <Setter Property="Scale" Value="1" />
                                                                            </VisualState.Setters>
                                                                        </VisualState>
                                                                        <VisualState x:Name="Pressed">
                                                                            <VisualState.Setters>
                                                                                <Setter Property="Scale" Value="0.9" />
                                                                                <Setter Property="BorderColor" Value="Black" />
                                                                            </VisualState.Setters>
                                                                        </VisualState>
                                                                        <VisualState x:Name="PointerOver">
                                                                            <VisualState.Setters>
                                                                                <Setter Property="BackgroundColor" Value="#222" />
                                                                            </VisualState.Setters>
                                                                        </VisualState>
                                                                    </VisualStateGroup>
                                                                </VisualStateGroupList>
                                                            </VisualStateManager.VisualStateGroups>
                                                        </Button>
                                                    </HorizontalStackLayout>
                                                    <HorizontalStackLayout Padding="10">
                                                        <Image
                                                            MinimumWidthRequest="500"
                                                            MaximumWidthRequest="500"
                                                            HorizontalOptions="Center"
                                                            VerticalOptions="Center">
                                                            <Image.Source>
                                                                <UriImageSource
                                                                    Uri="{Binding fileUrl}" />
                                                            </Image.Source>
                                                        </Image>
                                                    </HorizontalStackLayout>
                                                    <HorizontalStackLayout>
                                                        <Frame
                                                            BorderColor="Transparent"
                                                            Opacity="0.8"
                                                            BackgroundColor="Black">
                                                            <ScrollView
                                                                x:Name="scrollView"
                                                                MinimumHeightRequest="400"
                                                                MaximumHeightRequest="400"
                                                                MinimumWidthRequest="450"
                                                                MaximumWidthRequest="450">
                                                                <TableView Intent="Menu">
                                                                    <TableRoot>
                                                                        <TableSection Title="Parameters">
                                                                            <TextCell Text="Filename:" Detail="{Binding fileName}" />
                                                                            <TextCell Text="Mime Type:" Detail="{Binding mimeType}" />
                                                                            <TextCell Text="Format Info:" Detail="{Binding formatInfo}" />
                                                                            <TextCell Text="File Size:" Detail="{Binding fileSize}" />
                                                                            <TextCell Text="Dimensions:" Detail="{Binding dimensions}" />
                                                                            <TextCell Text="Megapixels:" Detail="{Binding megapixels}" />
                                                                        </TableSection>
                                                                    </TableRoot>
                                                                </TableView>
                                                            </ScrollView>
                                                        </Frame>
                                                    </HorizontalStackLayout>
                                                    <HorizontalStackLayout>
                                                        <Button
                                                            ToolTipProperties.Text="Copy URL"
                                                            Clicked="ImageFileSetClipboardButton_Clicked"
                                                            FontSize="12"
                                                            BackgroundColor="Transparent"
                                                            BorderColor="#444"
                                                            BorderWidth="1"
                                                            CornerRadius="5"
                                                            Padding="10"
                                                            Margin="10"
                                                            VerticalOptions="Center"
                                                            HorizontalOptions="Center">
                                                            <Button.ImageSource>
                                                                <FontImageSource
                                                                    FontFamily="FontAwesome7FreeSolid"
                                                                    Glyph="{StaticResource IconClone}"
                                                                    Size="12"
                                                                    Color="FloralWhite" />
                                                            </Button.ImageSource>
                                                            <VisualStateManager.VisualStateGroups>
                                                                <VisualStateGroupList>
                                                                    <VisualStateGroup x:Name="CommonStates">
                                                                        <VisualState x:Name="Normal">
                                                                            <VisualState.Setters>
                                                                                <Setter Property="Scale" Value="1" />
                                                                            </VisualState.Setters>
                                                                        </VisualState>
                                                                        <VisualState x:Name="Pressed">
                                                                            <VisualState.Setters>
                                                                                <Setter Property="Scale" Value="0.9" />
                                                                            </VisualState.Setters>
                                                                        </VisualState>
                                                                        <VisualState x:Name="PointerOver">
                                                                            <VisualState.Setters>
                                                                                <Setter Property="BackgroundColor" Value="#222" />
                                                                            </VisualState.Setters>
                                                                        </VisualState>
                                                                    </VisualStateGroup>
                                                                </VisualStateGroupList>
                                                            </VisualStateManager.VisualStateGroups>
                                                        </Button>
                                                        <Button
                                                            Text="Open Web URL"
                                                            TextColor="FloralWhite"
                                                            Clicked="ImageFileOpenWebURL_Clicked"
                                                            FontSize="12"
                                                            BackgroundColor="Transparent"
                                                            BorderColor="#444"
                                                            BorderWidth="1"
                                                            CornerRadius="5"
                                                            Padding="10"
                                                            Margin="10"
                                                            VerticalOptions="Center"
                                                            HorizontalOptions="Center">
                                                            <Button.ImageSource>
                                                                <FontImageSource
                                                                    FontFamily="FontAwesome7FreeSolid"
                                                                    Glyph="{StaticResource IconEarthEurope}"
                                                                    Size="12"
                                                                    Color="FloralWhite" />
                                                            </Button.ImageSource>
                                                            <VisualStateManager.VisualStateGroups>
                                                                <VisualStateGroupList>
                                                                    <VisualStateGroup x:Name="CommonStates">
                                                                        <VisualState x:Name="Normal">
                                                                            <VisualState.Setters>
                                                                                <Setter Property="Scale" Value="1" />
                                                                            </VisualState.Setters>
                                                                        </VisualState>
                                                                        <VisualState x:Name="Pressed">
                                                                            <VisualState.Setters>
                                                                                <Setter Property="Scale" Value="0.9" />
                                                                            </VisualState.Setters>
                                                                        </VisualState>
                                                                        <VisualState x:Name="PointerOver">
                                                                            <VisualState.Setters>
                                                                                <Setter Property="BackgroundColor" Value="#222" />
                                                                            </VisualState.Setters>
                                                                        </VisualState>
                                                                    </VisualStateGroup>
                                                                </VisualStateGroupList>
                                                            </VisualStateManager.VisualStateGroups>
                                                        </Button>
                                                    </HorizontalStackLayout>
                                                    <HorizontalStackLayout>
                                                        <Button
                                                            Text="Remove from selection"
                                                            Clicked="removeImageFileFromSelection"
                                                            TextColor="Gray"
                                                            BackgroundColor="Transparent"
                                                            FontSize="15"
                                                            Padding="10"
                                                            Margin="10"
                                                            BorderColor="#444"
                                                            BorderWidth="1"
                                                            WidthRequest="470"
                                                            VerticalOptions="Center"
                                                            HorizontalOptions="Center">
                                                            <VisualStateManager.VisualStateGroups>
                                                                <VisualStateGroupList>
                                                                    <VisualStateGroup x:Name="CommonStates">
                                                                        <VisualState x:Name="Normal">
                                                                            <VisualState.Setters>
                                                                                <Setter Property="Scale" Value="1" />
                                                                            </VisualState.Setters>
                                                                        </VisualState>
                                                                        <VisualState x:Name="Pressed">
                                                                            <VisualState.Setters>
                                                                                <Setter Property="Scale" Value="0.9" />
                                                                                <Setter Property="BorderColor" Value="Black" />
                                                                            </VisualState.Setters>
                                                                        </VisualState>
                                                                        <VisualState x:Name="PointerOver">
                                                                            <VisualState.Setters>
                                                                                <Setter Property="BackgroundColor" Value="#222" />
                                                                            </VisualState.Setters>
                                                                        </VisualState>
                                                                    </VisualStateGroup>
                                                                </VisualStateGroupList>
                                                            </VisualStateManager.VisualStateGroups>
                                                        </Button>
                                                    </HorizontalStackLayout>
                                                </VerticalStackLayout>
                                            </HorizontalStackLayout>
                                        </Grid>
                                    </DataTemplate>
                                </CollectionView.ItemTemplate>
                            </CollectionView>
                        </ScrollView>
                        <HorizontalStackLayout>
                            <Label
                                x:Name="ImageFileActionLabel"
                                FontSize="14"
                                FontAttributes="Bold"
                                BackgroundColor="Transparent"
                                TextColor="Gray"
                                VerticalTextAlignment="Center"
                                HorizontalTextAlignment="Start" />
                        </HorizontalStackLayout>
                    </VerticalStackLayout>
                    <VerticalStackLayout>
                        <HorizontalStackLayout>
                            <Label
                                x:Name="imageFilesCountLabel"
                                FontSize="14"
                                FontAttributes="Bold"
                                BackgroundColor="Transparent"
                                TextColor="Gray"
                                VerticalTextAlignment="Center"
                                HorizontalTextAlignment="Center"
                                Padding="10"
                                Margin="10" />

                            <Button
                                x:Name="selectAllImageFiles"
                                Text="Select Image Files"
                                FontSize="14"
                                FontAttributes="Bold"
                                SemanticProperties.Hint="Select Image Files"
                                BackgroundColor="Transparent"
                                TextColor="Gray">
                                <Button.ImageSource>
                                    <FontImageSource
                                        FontFamily="FontAwesome7FreeSolid"
                                        Glyph="{StaticResource IconSquareCaretDown}"
                                        Size="14"
                                        Color="Gray" />
                                </Button.ImageSource>
                                <VisualStateManager.VisualStateGroups>
                                    <VisualStateGroupList>
                                        <VisualStateGroup x:Name="CommonStates">
                                            <VisualState x:Name="Normal">
                                                <VisualState.Setters>
                                                    <Setter Property="Scale" Value="1" />
                                                </VisualState.Setters>
                                            </VisualState>
                                            <VisualState x:Name="Pressed">
                                                <VisualState.Setters>
                                                    <Setter Property="Scale" Value="0.9" />
                                                </VisualState.Setters>
                                            </VisualState>
                                            <VisualState x:Name="PointerOver">
                                                <VisualState.Setters>
                                                    <Setter Property="BorderColor" Value="Black" />
                                                </VisualState.Setters>
                                            </VisualState>
                                        </VisualStateGroup>
                                    </VisualStateGroupList>
                                </VisualStateManager.VisualStateGroups>
                            </Button>
                        </HorizontalStackLayout>

                        <SearchBar
                            x:Name="imageFilesSearchBar"
                            Placeholder="Search..."
                            BackgroundColor="Black"
                            TextColor="FloralWhite"
                            TextChanged="imageFilesSearchInputTextChanged" />

                        <Frame
                            BorderColor="Black"
                            CornerRadius="10">

                            <ScrollView
                                x:Name="scrollViewImageFilesList"
                                MaximumHeightRequest="700">

                                <CollectionView
                                    x:Name="imageFilesCollectionView"
                                    ItemsSource="{Binding ImageFiles}"
                                    SelectionMode="Multiple"
                                    SelectionChanged="ImageFilesSelectionChanged"
                                    SelectedItems="{Binding SelectedImageFiles}">

                                    <CollectionView.EmptyView>
                                        <Label
                                            Text="No data found."
                                            FontSize="15"
                                            BackgroundColor="Transparent"
                                            TextColor="FloralWhite"
                                            HorizontalOptions="Center"
                                            VerticalOptions="Center" />
                                    </CollectionView.EmptyView>
                                    <CollectionView.ItemTemplate>
                                        <DataTemplate>
                                            <Grid Padding="10">
                                                <Grid.RowDefinitions>
                                                    <RowDefinition Height="Auto" />
                                                    <RowDefinition Height="Auto" />
                                                </Grid.RowDefinitions>
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="Auto" />
                                                    <ColumnDefinition Width="Auto" />
                                                </Grid.ColumnDefinitions>
                                                <HorizontalStackLayout>
                                                    <CheckBox
                                                        CheckedChanged="imageFileCheckedChanged"
                                                        ClassId="{Binding id}">
                                                        <VisualStateManager.VisualStateGroups>
                                                            <VisualStateGroupList>
                                                                <VisualStateGroup x:Name="CommonStates">
                                                                    <VisualState x:Name="Normal">
                                                                        <VisualState.Setters>
                                                                            <Setter
                                                                                Property="Color"
                                                                                Value="White" />
                                                                        </VisualState.Setters>
                                                                    </VisualState>
                                                                    <VisualState x:Name="IsChecked">
                                                                        <VisualState.Setters>
                                                                            <Setter
                                                                                Property="Color"
                                                                                Value="LightCyan" />
                                                                        </VisualState.Setters>
                                                                    </VisualState>
                                                                </VisualStateGroup>
                                                            </VisualStateGroupList>
                                                        </VisualStateManager.VisualStateGroups>
                                                    </CheckBox>
                                                    <Button
                                                        Grid.Row="0"
                                                        Grid.Column="1"
                                                        Text="{Binding fileName}"
                                                        Clicked="addImageFileToSelection"
                                                        TextColor="FloralWhite"
                                                        BackgroundColor="Transparent"
                                                        FontSize="15"
                                                        Padding="10">
                                                        <Button.ImageSource>
                                                            <FontImageSource
                                                                FontFamily="FontAwesome7FreeRegular"
                                                                Glyph="{StaticResource IconFileImage}"
                                                                Size="20"
                                                                Color="FloralWhite" />
                                                        </Button.ImageSource>
                                                    </Button>
                                                    <Button
                                                        Grid.Row="0"
                                                        Grid.Column="2"
                                                        Text="{Binding mimeType}"
                                                        Clicked="addImageFileToSelection"
                                                        TextColor="LightGrey"
                                                        BackgroundColor="Transparent"
                                                        FontSize="12"
                                                        Padding="10">
                                                    </Button>
                                                </HorizontalStackLayout>
                                            </Grid>
                                        </DataTemplate>
                                    </CollectionView.ItemTemplate>
                                </CollectionView>
                            </ScrollView>
                        </Frame>
                        <HorizontalStackLayout>
                            <Label
                                x:Name="selectedImageFilesCountLabel"
                                FontSize="14"
                                FontAttributes="Bold"
                                BackgroundColor="Transparent"
                                TextColor="Gray"
                                VerticalTextAlignment="Center"
                                HorizontalTextAlignment="Start"
                                Padding="10"
                                Margin="10" />
                            <Picker x:Name="ImageFileActionPicker"
                                FontSize="14"
                                FontAttributes="Bold"
                                SemanticProperties.Hint="Select Action"
                                BackgroundColor="Transparent"
                                TextColor="Gray"
                                Margin="10" />
                            <Button
                                x:Name="updateImageFilesButton"
                                Text="Update Image Files"
                                FontSize="14"
                                Clicked="updateImageFilesButtonClicked"
                                FontAttributes="Bold"
                                SemanticProperties.Hint="Update Image Files"
                                BackgroundColor="Black"
                                BorderColor="Black"
                                BorderWidth="1"
                                CornerRadius="5"
                                TextColor="Gray"
                                Padding="10"
                                Margin="10">
                                <Button.ImageSource>
                                    <FontImageSource
                                        x:Name="updateImageFilesButtonImage"
                                        FontFamily="FontAwesome7FreeSolid"
                                        Glyph="{StaticResource IconChevronRight}"
                                        Size="20"
                                        Color="Gray" />
                                </Button.ImageSource>
                                <VisualStateManager.VisualStateGroups>
                                    <VisualStateGroupList>
                                        <VisualStateGroup x:Name="CommonStates">
                                            <VisualState x:Name="Normal">
                                                <VisualState.Setters>
                                                    <Setter Property="Scale" Value="1" />
                                                </VisualState.Setters>
                                            </VisualState>
                                            <VisualState x:Name="Pressed">
                                                <VisualState.Setters>
                                                    <Setter Property="Scale" Value="0.9" />
                                                </VisualState.Setters>
                                            </VisualState>
                                            <VisualState x:Name="PointerOver">
                                                <VisualState.Setters>
                                                    <Setter Property="BorderColor" Value="#444" />
                                                </VisualState.Setters>
                                            </VisualState>
                                        </VisualStateGroup>
                                    </VisualStateGroupList>
                                </VisualStateManager.VisualStateGroups>
                            </Button>
                            <Button
                                Text="Refresh"
                                x:Name="refreshImageFilesButton"
                                BackgroundColor="Black"
                                TextColor="FloralWhite"
                                FontSize="14"
                                VerticalOptions="Center"
                                HorizontalOptions="Center">
                                <Button.ImageSource>
                                    <FontImageSource
                                        FontFamily="FontAwesome7FreeSolid"
                                        Glyph="{StaticResource IconRotate}"
                                        Size="15"
                                        Color="FloralWhite" />
                                </Button.ImageSource>
                                <VisualStateManager.VisualStateGroups>
                                    <VisualStateGroupList>
                                        <VisualStateGroup x:Name="CommonStates">
                                            <VisualState x:Name="Normal">
                                                <VisualState.Setters>
                                                    <Setter Property="Scale" Value="1" />
                                                </VisualState.Setters>
                                            </VisualState>
                                            <VisualState x:Name="Pressed">
                                                <VisualState.Setters>
                                                    <Setter Property="Scale" Value="0.9" />
                                                </VisualState.Setters>
                                            </VisualState>
                                            <VisualState x:Name="PointerOver">
                                                <VisualState.Setters>
                                                    <Setter Property="BorderColor" Value="#444" />
                                                </VisualState.Setters>
                                            </VisualState>
                                        </VisualStateGroup>
                                    </VisualStateGroupList>
                                </VisualStateManager.VisualStateGroups>
                            </Button>
                        </HorizontalStackLayout>
                    </VerticalStackLayout>
                </HorizontalStackLayout>
            </Grid>

            <Grid x:Name="GridImageFilesDetails">
                <HorizontalStackLayout>
                    <VerticalStackLayout MinimumWidthRequest="300" MaximumWidthRequest="400">
                        <Label
                            x:Name="folderName1"
                            FontSize="20"
                            HorizontalOptions="Center"
                            TextColor="FloralWhite"
                            BackgroundColor="Transparent"
                            Padding="10" />
                    </VerticalStackLayout>
                    <VerticalStackLayout MinimumWidthRequest="200" MaximumWidthRequest="200">
                    </VerticalStackLayout>
                    <VerticalStackLayout MinimumWidthRequest="300" MaximumWidthRequest="400">
                        <Label
                            x:Name="imageFilesCount"
                            FontSize="20"
                            HorizontalOptions="Center"
                            TextColor="FloralWhite"
                            BackgroundColor="Transparent"
                            Padding="10" />
                    </VerticalStackLayout>
                </HorizontalStackLayout>
            </Grid>

            <Grid x:Name="GridVideoFiles">
                <HorizontalStackLayout Padding="50">
                    <VerticalStackLayout MinimumWidthRequest="400" MaximumHeightRequest="800">
                        <ScrollView
                            x:Name="scrollViewSelectedVideoFilesList"
                            Grid.Row="0"
                            VerticalOptions="Fill">

                            <CollectionView
                                ItemsSource="{Binding SelectedVideoFiles}"
                                SelectionMode="Multiple"
                                SelectionChanged="SelectedVideoFilesSelectionChanged">

                                <CollectionView.ItemTemplate>
                                    <DataTemplate>
                                        <Grid Padding="10">
                                            <Grid.RowDefinitions>
                                                <RowDefinition Height="Auto" />
                                                <RowDefinition Height="Auto" />
                                            </Grid.RowDefinitions>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="Auto" />
                                                <ColumnDefinition Width="Auto" />
                                            </Grid.ColumnDefinitions>
                                            <HorizontalStackLayout>
                                                <VerticalStackLayout>
                                                    <HorizontalStackLayout>
                                                        <Button
                                                            Text="⭠ Previous"
                                                            Clicked="previousLinkVideoFileClicked"
                                                            TextColor="Gray"
                                                            BackgroundColor="Transparent"
                                                            FontSize="15"
                                                            Padding="10"
                                                            BorderColor="#444"
                                                            BorderWidth="1"
                                                            WidthRequest="100"
                                                            VerticalOptions="Center"
                                                            HorizontalOptions="Start">
                                                            <VisualStateManager.VisualStateGroups>
                                                                <VisualStateGroupList>
                                                                    <VisualStateGroup x:Name="CommonStates">
                                                                        <VisualState x:Name="Normal">
                                                                            <VisualState.Setters>
                                                                                <Setter Property="Scale" Value="1" />
                                                                            </VisualState.Setters>
                                                                        </VisualState>
                                                                        <VisualState x:Name="Pressed">
                                                                            <VisualState.Setters>
                                                                                <Setter Property="Scale" Value="0.9" />
                                                                                <Setter Property="BorderColor" Value="Black" />
                                                                            </VisualState.Setters>
                                                                        </VisualState>
                                                                        <VisualState x:Name="PointerOver">
                                                                            <VisualState.Setters>
                                                                                <Setter Property="BackgroundColor" Value="#222" />
                                                                            </VisualState.Setters>
                                                                        </VisualState>
                                                                    </VisualStateGroup>
                                                                </VisualStateGroupList>
                                                            </VisualStateManager.VisualStateGroups>
                                                        </Button>

                                                        <Rectangle WidthRequest="10" BackgroundColor="Transparent" />

                                                        <Button
                                                            Text="Load Video File"
                                                            Clicked="playVideoFileClicked"
                                                            TextColor="Grey"
                                                            BackgroundColor="Transparent"
                                                            FontSize="15"
                                                            Padding="10"
                                                            BorderColor="#444"
                                                            BorderWidth="1"
                                                            WidthRequest="250"
                                                            VerticalOptions="Center"
                                                            HorizontalOptions="Center">
