<?xml version="1.0" encoding="UTF-8" ?>
<Shell
    x:Class="MauiApp1.AppShell"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:strings="clr-namespace:MauiApp1.Resources.Strings"
    xmlns:local="clr-namespace:MauiApp1"
    Title="Appshare"
    FlyoutIsPresented="True"
    FlyoutBehavior="Locked">

    <!-- The pages' root, hidden: tapping the flyout's only, already selected
         item does nothing, so the Account menu item below does the navigation -->
    <FlyoutItem Title="{strings:Translate AccountTitle}" FlyoutItemIsVisible="False">
        <Tab>
            <ShellContent ContentTemplate="{DataTemplate local:AccountPage}" />
        </Tab>
    </FlyoutItem>

    <!-- My Account when signed in, the Sign In page otherwise -->
    <MenuItem Text="{strings:Translate AccountTitle}" Clicked="AccountMenuItemClicked" />

</Shell>
